# Application
ENV=local
APP_NAME=cannabis-backend
APP_VERSION=0.1.0

# Database — async driver for runtime, sync for Alembic
DATABASE_URL=postgresql+asyncpg://postgres:admin@localhost:5432/cannabis_analysis
SYNC_DATABASE_URL=postgresql+psycopg2://postgres:admin@localhost:5432/cannabis_analysis

# CORS — comma-separated origins allowed to call the API
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Logging
LOG_LEVEL=INFO
