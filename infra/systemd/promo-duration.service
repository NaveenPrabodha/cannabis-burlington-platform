[Unit]
Description=Recompute promo_first_seen / promo_last_seen on fct_prices
After=scrape-ocs.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=ec2-user
WorkingDirectory=/home/ec2-user/cannabis-burlington-platform/pipeline
EnvironmentFile=/home/ec2-user/cannabis-burlington-platform/pipeline/.env
ExecStart=/home/ec2-user/.local/bin/uv run python -m pipeline.jobs.compute_promo_duration
StandardOutput=append:/var/log/cannabis-pipeline.log
StandardError=append:/var/log/cannabis-pipeline.log
