# Used by docker-compose. Copy to .env (kept out of git via root .gitignore).

# Local-only Postgres password (db service)
POSTGRES_PASSWORD=changeme_local_only

# Backend container DB connection.
#   Local:  use the bundled db service: postgresql+asyncpg://postgres:${POSTGRES_PASSWORD}@db:5432/cannabis_analysis
#   Prod:   point at AWS RDS:           postgresql+asyncpg://USER:PASS@<rds-host>:5432/cannabis_analysis
BACKEND_DATABASE_URL=postgresql+asyncpg://postgres:changeme_local_only@db:5432/cannabis_analysis

# What the frontend's API client baked at build time uses.
#   Local docker:   http://localhost:8000   (browser → host → backend container)
#   Prod (EC2):     https://your-domain.com or http://your-ec2-ip
PUBLIC_API_BASE_URL=http://localhost:8000

# CORS — comma-separated origins the API will allow
CORS_ORIGINS=http://localhost:3000,http://localhost

ENV=local
APP_VERSION=0.1.0
